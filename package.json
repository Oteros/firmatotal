{
  "name": "firma-total",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:vendor": "node scripts/fetch-autoscript.mjs",
    "prepare:cookies": "node scripts/generate-cookie-locales.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "predev": "npm run prepare:editorial && npm run prepare:vendor && npm run prepare:cookies && npm run generate:seo",
    "dev": "vite",
    "prebuild": "npm run prepare:editorial && npm run prepare:vendor && npm run prepare:cookies && npm run generate:seo",
    "build": "vite build && node scripts/generate-locale-shells.mjs",
    "test": "node --test",
    "validate:bundle": "node scripts/check-bundle-budget.mjs",
    "validate:site": "node scripts/validate-site.mjs dist",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name firmatotal --branch main",
    "prepare:editorial": "node scripts/sync-editorial.mjs",
    "postbuild": "node scripts/apply-seo-overrides.mjs dist"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.2.6",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.5",
    "@signpdf/utils": "^3.2.4",
    "buffer": "^6.0.3",
    "node-forge": "https://codeload.github.com/digitalbazaar/forge/tar.gz/f192c67ee5850e44296ef83d6a7b6df6552ba8bf",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "node-forge": "$node-forge"
  }
}
