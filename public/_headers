/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://play.google.com https://tools.applemediaservices.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://127.0.0.1:* wss://127.0.0.1:*; worker-src 'self' blob:; frame-src 'self' afirma:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=604800
